//- Chat flotante con Gemini. Se incluye desde layout.pug.
//- Se usan <div> y no <header>/<footer>/<section> porque style.css tiene reglas
//- globales para esos elementos que alterarían el aspecto del chat.
#chat-widget
  div#chat-ventana.chat-ventana(role="dialog", aria-label="Asistente virtual de TurnoFlex", hidden)
    div.chat-cabecera
      div.chat-titulo
        strong Asistente TurnoFlex
        span Con tecnología de Gemini
      button#chat-cerrar.chat-cerrar(type="button", aria-label="Cerrar asistente virtual")
        svg(viewBox="0 0 24 24", width="18", height="18", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
          path(d="M18 6 6 18M6 6l12 12")

    div#chat-mensajes.chat-mensajes(role="log", aria-live="polite", aria-relevant="additions")

    form#chat-formulario.chat-formulario(autocomplete="off")
      textarea#chat-entrada(rows="1", maxlength="1000", placeholder="Escribe tu consulta...", aria-label="Mensaje para el asistente")
      button#chat-enviar.chat-enviar(type="submit", aria-label="Enviar mensaje")
        svg(viewBox="0 0 24 24", width="18", height="18", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
          path(d="M22 2 11 13M22 2l-7 20-4-9-9-4z")

    p.chat-aviso Asistente con IA. No compartas datos personales ni de salud.

  button#chat-toggle.chat-toggle(type="button", aria-label="Abrir asistente virtual", aria-expanded="false", aria-controls="chat-ventana")
    svg.chat-icono-abrir(viewBox="0 0 24 24", width="26", height="26", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
      path(d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z")
    svg.chat-icono-cerrar(viewBox="0 0 24 24", width="26", height="26", fill="none", stroke="currentColor", stroke-width="2", stroke-linecap="round", stroke-linejoin="round", aria-hidden="true")
      path(d="m6 9 6 6 6-6")
