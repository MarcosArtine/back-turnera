doctype html
html(lang='es')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    link(rel='stylesheet', href='/styles/style.css')
    link(rel='icon', href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='22' fill='%230f766e'/%3E%3Cpath d='M44 22h12v22h22v12H56v22H44V56H22V44h22z' fill='white'/%3E%3C/svg%3E")
    title TurnoFlex | Gestión de turnos

  body
    header
      h1 TurnoFlex
      nav
        ul
          li: a(href='/mensajes') Chat
          li: a(href='/turnos')= usuario && usuario.rol === 'profesional' ? 'Mis Turnos' : 'Lista de Turnos'
          if usuario && usuario.rol === 'admin'
            li: a(href='/pacientes') Lista de Pacientes
            li: a(href='/profesionales') Lista de Profesionales
            li: a(href='/especialidades') Lista de Especialidades
          li
            form(method="POST", action="/logout", data-fetch-form, data-success-redirect="/login")
              button(type="submit") Cerrar sesión

    hr

    block content

    hr

    footer
      p &copy; 2026 TurnoFlex &middot; Gestión de turnos médicos &middot; Grupo 12

script(src="/scripts/script.js")