doctype html
html(lang='es')
  head
    meta(charset='UTF-8')
    meta(name='viewport', content='width=device-width, initial-scale=1.0')
    link(rel='stylesheet', href='/styles/style.css')
    title CRUD de Turnos

  body
    header
      h1 CRUD de Turnos
      nav
        ul
          li: a(href='/turnos')= usuario && usuario.rol === 'profesional' ? 'Mis Turnos' : 'Lista de Turnos'
          if usuario && usuario.rol === 'admin'
            li: a(href='/pacientes') Lista de Pacientes
            li: a(href='/profesionales') Lista de Profesionales
            li: a(href='/especialidades') Lista de Especialidades
          li
            form(method="POST", action="/logout", data-fetch-form, data-success-redirect="/login")
              button(type="submit") Cerrar sesión

    hr

    block content

    hr

    footer
      p &copy; 2026 CRUD de turnos medicos. Grupo 12.

script(src="/scripts/script.js")