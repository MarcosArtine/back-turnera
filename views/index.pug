extends layout 

block content
  h2 Lista de Turnos
  form(method="GET", action="/turnos/nuevo")
    button(type="submit") Nuevo Turno
  if turnos.length > 0
    table
      thead
        tr
          th ID
          th Nombre del Paciente
          th Apellido del Paciente
          th Fecha y Hora
          th Especialidad
          th Estado
          th Acciones
      tbody
        each turno in turnos
          tr
            td= turno.id_turno
            td= turno.nombrePaciente
            td= turno.apellidoPaciente
            td= new Date(turno.fecha_hora_inicio).toLocaleString()
            td= turno.especialidad
            td= turno.estado
            td
              form(method="GET", action=`/turnos/${turno.id_turno}/editar`, style="display:inline")
                button(type="submit") Editar
              |  |
              form(method="POST", action=`/turnos/${turno.id_turno}/eliminar`, style="display:inline")
                button(type="submit", onclick="return confirm('¿Está seguro de eliminar este turno?')") Eliminar
  else
    p No hay turnos disponibles.